# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite .env.local (já está no .gitignore).

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta: só usada em código de servidor (envio de notificações, criação de funcionário).
# Nunca coloque em variável NEXT_PUBLIC_ nem no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Telegram — SÓ notificações (vendas, cancelamentos, estoque). Ninguém registra venda por lá.
# Token do bot (criado via @BotFather)
TELEGRAM_BOT_TOKEN=
# Destinatários (dono + gerentes/admins) NÃO vão aqui: cada um manda /start ao bot para descobrir
# seu chat ID e um administrador cola em Funcionários > Telegram (coluna telegram_chat_id).
# String aleatória escolhida por você: valida que o webhook (/start) veio mesmo do Telegram
TELEGRAM_WEBHOOK_SECRET=

# Protege /api/notifications/process (reenvio automático de notificações que falharam).
# Gere uma string longa e aleatória. Opcional: sem ela, só admin logado consegue chamar.
CRON_SECRET=
