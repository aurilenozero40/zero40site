# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite .env.local (já está no .gitignore).

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave secreta, só usada em rotas server-side (webhook do Telegram, provisionamento de funcionário)
SUPABASE_SERVICE_ROLE_KEY=

# Bot do Telegram (criado via @BotFather)
TELEGRAM_BOT_TOKEN=
# String aleatória escolhida por você, usada para validar que o webhook veio do Telegram
TELEGRAM_WEBHOOK_SECRET=
